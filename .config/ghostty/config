font-family = "Comic Code Ligatures"
font-style = Medium
font-size = 11

background = #111111
foreground = #f8f8f2
palette = 0=#000000
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#50fa7b
palette = 11=#f1fa8c
palette = 12=#bd93f9
palette = 13=#ff79c6
palette = 14=#8be9fd
palette = 15=#ffffff
cursor-color = #bbbbbb
cursor-text = #ffffff
selection-background = #44475a
selection-foreground = #ffffff

background-opacity = 0.8
unfocused-split-opacity = 1
window-padding-x = 0
window-padding-y = 0
window-decoration = none
working-directory = home
window-inherit-working-directory = false

keybind = ctrl+shift+|=new_split:right
keybind = ctrl+shift+_=new_split:down
keybind = ctrl+shift+h=resize_split:left,5
keybind = ctrl+shift+j=resize_split:down,5
keybind = ctrl+shift+k=resize_split:up,5
keybind = ctrl+shift+l=resize_split:right,5
keybind = ctrl+shift+m=toggle_split_zoom
